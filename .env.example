# Host UID/GID for docker compose — see docker-compose.yml's ``user:`` field.
# The Makefile exports these automatically; only set them here if you plan
# to run ``docker compose`` directly without going through ``make``.
#   HOST_UID=1000
#   HOST_GID=1000

DATABASE_URL=postgres://postgres:postgres@db:5432/painminer
REDIS_URL=redis://redis:6379/0
DJANGO_SECRET_KEY=replace-me
DEBUG=True
ANTHROPIC_API_KEY=
APPROVER=notifications.approvers.DjangoAdminApprover
EMAIL_DIGEST_RECIPIENT=
DEFAULT_FROM_EMAIL=painminer@localhost
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
MODEL_FILTER=claude-haiku-4-5
MODEL_INVESTIGATION=claude-sonnet-4-6
DEFAULT_BUDGET_MAX_STEPS=30
DEFAULT_BUDGET_MAX_COST_USD=0.50
DEFAULT_BUDGET_MAX_DURATION_S=300
CLUSTER_JOIN_THRESHOLD=0.75
CLUSTER_MERGE_THRESHOLD=0.82
CLUSTER_REASSIGN_MARGIN=0.05
CLUSTER_RECENCY_DAYS=90
SPLIT_SIZE_THRESHOLD=30
SPLIT_VARIANCE_THRESHOLD=0.4
