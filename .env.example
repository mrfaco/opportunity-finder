# Host UID/GID for docker compose — see docker-compose.yml's ``user:`` field.
# The Makefile exports these automatically; only set them here if you plan
# to run ``docker compose`` directly without going through ``make``.
#   HOST_UID=1000
#   HOST_GID=1000

DATABASE_URL=postgres://postgres:postgres@db:5432/painminer
REDIS_URL=redis://redis:6379/0
DJANGO_SECRET_KEY=replace-me
DEBUG=True
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5
# Tavily (https://tavily.com/) — 1000 free credits/month. Used by web_search.
TAVILY_API_KEY=
# GitHub PAT (https://github.com/settings/tokens) — public_repo scope is enough.
# Used by search_github_issues for the 30 req/min authenticated rate.
GITHUB_TOKEN=
# Stack Exchange key (https://stackapps.com/apps/oauth/register) — OPTIONAL.
# Lifts daily quota from 300 to 10,000; the API works without it.
STACKEXCHANGE_KEY=
INGEST_HN_INITIAL_DAYS=7
APPROVER=notifications.approvers.DjangoAdminApprover
EMAIL_DIGEST_RECIPIENT=
DEFAULT_FROM_EMAIL=painminer@localhost
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
MODEL_FILTER=claude-haiku-4-5
MODEL_INVESTIGATION=claude-sonnet-4-6
DEFAULT_BUDGET_MAX_STEPS=30
DEFAULT_BUDGET_MAX_COST_USD=0.50
DEFAULT_BUDGET_MAX_DURATION_S=300
CLUSTER_JOIN_THRESHOLD=0.75
CLUSTER_MERGE_THRESHOLD=0.82
CLUSTER_REASSIGN_MARGIN=0.05
CLUSTER_RECENCY_DAYS=90
SPLIT_SIZE_THRESHOLD=30
SPLIT_VARIANCE_THRESHOLD=0.4

# Search-led discovery (independent of legacy ingestion/embeddings).
OPENROUTER_API_KEY=
DISCOVERY_RUNTIME=claude_code
DISCOVERY_FINDER_PROVIDER=openrouter
DISCOVERY_VALIDATOR_PROVIDER=openrouter
DISCOVERY_FINDER_MODEL=deepseek/deepseek-v4.1-flash
# Prefer a different model family for Validator; provider/model choices are independent.
# Identical defaults are allowed but are flagged in reports for shared blind spots.
DISCOVERY_VALIDATOR_MODEL=deepseek/deepseek-v4.1-flash
# Judge reviews Finder/Validator agreement before a new run can converge.
DISCOVERY_JUDGE_ENABLED=True
DISCOVERY_JUDGE_PROVIDER=ollama
DISCOVERY_JUDGE_MODEL=kimi-k3:cloud
# Anthropic: select anthropic and native model ID (e.g. sonnet); use the host's
# Claude Code login or ANTHROPIC_API_KEY. Ollama: select ollama and its exact tag.
# Batch settings below are retained only for historical batch discoveries.
DISCOVERY_BATCH_PROVIDER=sail-research
DISCOVERY_BATCH_POLL_SECONDS=60
# search_auto explicitly tries DuckDuckGo then Bing on source failure; each attempt is audited.
# Select web_search,web_fetch instead for Tavily with TAVILY_API_KEY configured.
DISCOVERY_CONNECTORS=search_auto,web_fetch
DISCOVERY_CONNECTOR_CLASSES=
# reddit works unauthenticated (6 s between requests); cloud IPs are often denied.
# Optional Reddit "script"/web app (https://www.reddit.com/prefs/apps): with both set,
# reddit uses client-credentials OAuth on oauth.reddit.com (free; about 100 requests/min).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# open_data_ckan: comma-separated CKAN API base URLs (no key; 1 s between requests).
# With more than one, every search names its portal (the host without www.).
DISCOVERY_CKAN_PORTALS=https://datos.gob.ar,https://datos.gob.mx,https://dados.gov.br,https://datos.gob.es,https://www.govdata.de/ckan,https://catalog.data.gov
